# Cap Table environment variables.

# Hedera testnet RPC (chain id 296).
HEDERA_RPC=https://testnet.hashio.io/api
HEDERA_RPC_FALLBACK=https://testnet.arkhia.io/api

# Funded deployer/issuer/seller account. The seller must be KYC-granted and
# hold the bond total supply before auction creation.
DEPLOYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=

# ATS reference deployment on Hedera testnet (current, v1.17.0+).
ATS_FACTORY=0x5fA65CA30d1984701F10476664327f97c864A9D3
BLR_PROXY=0xEFEF4CAe9642631Cfc6d997D6207Ee48fa78fe42

# Postgres for the indexer.
DATABASE_URL=postgresql://cap_table:cap_table@127.0.0.1:5432/cap_table
INDEXER_PORT=8080

# Web app (Vite — the frontend reads only VITE_* variables).
VITE_INDEXER_API=http://localhost:8080
VITE_HEDERA_RPC=https://testnet.hashio.io/api
